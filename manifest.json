{
  "manifest_version": 3,
  "name": "Twitter Unlimited Accounts",
  "version": "2.1.1",
  "description": "Save and switch between multiple X accounts. Dashboard, groups and unread badges. All data stays local.",
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "commands": {
    "switch-1": { "suggested_key": { "default": "Ctrl+Shift+1" }, "description": "Switch to account #1" },
    "switch-2": { "suggested_key": { "default": "Ctrl+Shift+2" }, "description": "Switch to account #2" },
    "switch-3": { "suggested_key": { "default": "Ctrl+Shift+3" }, "description": "Switch to account #3" },
    "switch-4": { "suggested_key": { "default": "Ctrl+Shift+4" }, "description": "Switch to account #4" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
